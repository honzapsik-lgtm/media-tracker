generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  SHOW
  MOVIE
  GAME
  MANGA
  OTHER
}

model Media {
  id              String    @id @default(uuid())
  anilistId       Int?      @unique
  title           String?
  type            MediaType
  isMainStoryline Boolean   @default(false)
  releaseDate     String?

  // External ID Mapping Layer (The Rosetta Stone Columns)
  tmdbId     Int?    @unique // Used to link Anime to TMDb for episodes
  igdbId     Int?    @unique // Primary key for the new Video Game backend
  mangadexId String? @unique // UUID for fetching high-res manga covers
  malId      Int?    @unique // Required exclusively for Jikan API (MyAnimeList)

  // New Rich Data Caches
  themeData Json? // structure: { openings: string[], endings: string[] }
  watchData Json? // structure: { flatrate: Provider[], rent: Provider[], buy: Provider[] }
  episodeData Json? // root season episode metadata, used when the franchise root also acts as season 1

  relatedMediaId String?
  relatedMedia   Media?  @relation("MediaToMedia", fields: [relatedMediaId], references: [id])
  inverseRelated Media[] @relation("MediaToMedia")

  seasons    Season[]
  episodes   Episode[]
  staffData  Json?
  castData   Json?
  studioData Json?

  franchiseSyncedAt DateTime?

  @@map("media")
}

model Season {
  id          String  @id @default(uuid())
  anilistId   Int?    @unique
  tmdbId      Int?    @unique
  episodeData Json?
  mediaId     String
  releaseDate String?
  media       Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  staffData  Json?
  castData   Json?
  studioData Json?
  themeData  Json?

  @@map("seasons")
}

model Episode {
  id          String @id @default(uuid())
  anilistId   Int?   @unique
  tmdbId      Int?   @unique
  episodeData Json?
  mediaId     String
  media       Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("episodes")
}

model MediaStats {
  id                String    @id
  media_type        MediaType
  community_average Decimal?  @default(0) @db.Decimal
  total_ratings     Int?      @default(0)

  @@map("media_stats")
}

model UserBadge {
  user_id     String    @db.Uuid
  badge_id    String
  unlocked_at DateTime? @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, badge_id])
  @@map("user_badges")
}

model UserList {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  title       String
  description String?
  media_type  MediaType
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user  User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items UserListItem[]

  @@index([user_id, media_type])
  @@map("user_lists")
}

model UserListItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  list_id       String  @db.Uuid
  media_id      String
  media_title   String?
  media_image   String?
  rank_position Int // 1-indexed relative ordering inside this specific list

  list UserList @relation(fields: [list_id], references: [id], onDelete: Cascade)

  @@unique([list_id, media_id])
  @@index([list_id, rank_position])
  @@map("user_list_items")
}

model GlobalRanking {
  media_id   String    @id
  media_type MediaType
  elo_score  Float     @default(1200.0)
  rank       Int? // Cached global integer ranking position calculated dynamically

  @@index([media_type, elo_score(sort: Desc)])
  @@map("global_rankings")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model UserRating {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  media_id           String
  media_title        String?
  media_image        String?
  media_release_date String?
  score              Int
  review_text        String?
  username           String?
  avatar_url         String?
  criteria_scores    Json?    @default("{}")
  is_deep_review     Boolean? @default(false)
  rank_position      Int?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, media_id])
  @@map("user_ratings")
}

enum WatchlistStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  DROPPED
}

model UserWatchlist {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?         @db.Uuid
  media_id        String
  media_title     String?
  media_image     String?
  media_type      MediaType?
  status          WatchlistStatus @default(PLANNING)
  added_at        DateTime?       @default(now()) @db.Timestamptz(6)
  started_at      DateTime?       @db.Timestamptz(6)
  finished_at     DateTime?       @db.Timestamptz(6)
  
  // Shows / Anime
  episodesWatched Int             @default(0)
  is_rewatching   Boolean         @default(false)
  
  // Manga
  chaptersRead    Int             @default(0)
  volumesRead     Int             @default(0)
  is_rereading    Boolean         @default(false)
  
  // Video Games
  hoursPlayed     Float           @default(0.0)
  platform        String?
  
  // Movies
  watchCount      Int             @default(0)

  user            User?           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, media_id])
  @@map("user_watchlist")
}

model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  media_id    String
  increment   String
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("activity_log")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  username       String?   @unique
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  realName       String?
  stateRegion    String?
  country        String?
  showcaseBadges String[]  @default([])
  role           String    @default("user")

  // Relations to the new NextAuth tables and your existing tables
  accounts                Account[]
  sessions                Session[]
  ratings                 UserRating[]
  watchlist               UserWatchlist[]
  badges                  UserBadge[]
  lists                   UserList[]
  stats_cache             UserStatsCache[]
  activity_logs           ActivityLog[]
  sentFriendRequests      Friendship[]           @relation("SentFriendRequests")
  receivedFriendRequests  Friendship[]           @relation("ReceivedFriendRequests")
  activities              UserActivity[]
  privacySettings         UserPrivacySettings?
  friendPreferences       UserFriendPreference[] @relation("UserFriendPrefs")
  targetFriendPreferences UserFriendPreference[] @relation("FriendOfUserPrefs")

  @@map("users")
}

// 2. NextAuth Required Tables (OAuth Accounts & Sessions)
model Account {
  id                String  @id @default(cuid())
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiCache {
  id         String   @id
  provider   String
  data       Json
  created_at DateTime @default(now())
  expires_at DateTime
}

model UserStatsCache {
  user_id    String    @db.Uuid
  media_type MediaType
  stats_json Json
  updated_at DateTime  @updatedAt
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, media_type])
}

model BackgroundJob {
  id           String    @id @default(uuid())
  type         String
  payload      Json
  status       String    @default("pending")
  dedupe_key   String?
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  run_at       DateTime  @default(now())
  locked_at    DateTime?
  locked_by    String?
  last_error   String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  processed_at DateTime?

  @@index([status, run_at])
  @@index([type, status])
  @@index([locked_at])
  @@index([dedupe_key])
  @@index([created_at])
}

model SystemLog {
  id           String   @id @default(cuid())
  level        String
  event        String
  message      String?
  requestId    String?
  userId       String?
  mediaId      String?
  mediaType    String?
  jobId        String?
  durationMs   Int?
  metadata     Json?
  errorName    String?
  errorMessage String?
  errorStack   String?
  createdAt    DateTime @default(now())

  @@index([level, createdAt])
  @@index([event, createdAt])
  @@index([requestId])
  @@index([userId, createdAt])
  @@index([mediaId, createdAt])
  @@index([jobId])
  @@index([createdAt])
}

model Person {
  id                 String   @id @default(uuid())
  tmdbId             Int?     @unique
  anilistId          Int?     @unique
  igdbId             Int?     @unique
  malId              Int?     @unique
  rawgId             Int?     @unique
  mangadexId         String?  @unique
  
  name               String
  nativeName         String?
  biography          String?
  profileImage       String?
  birthDate          String?
  deathDate          String?
  knownForDepartment String?
  
  mergedCredits      Json?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("people")
}

model Company {
  id            String   @id @default(uuid())
  tmdbId        Int?     @unique
  anilistId     Int?     @unique
  igdbId        Int?     @unique
  tmdbNetworkId Int?     @unique
  
  name          String
  description   String?
  logoUrl       String?
  country       String?
  
  mergedWorks   Json?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("companies")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Friendship {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String           @db.Uuid
  receiver_id String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  sender   User @relation("SentFriendRequests", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, receiver_id])
  @@index([sender_id, status])
  @@index([receiver_id, status])
  @@map("friendships")
}

enum ActivityType {
  RATED_MEDIA
  WATCHLIST_STATUS
  EPISODES_WATCHED
  CHAPTERS_READ
  VOLUMES_READ
  HOURS_PLAYED
  FAVORITED
  CUSTOM
}

model UserActivity {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String       @db.Uuid
  type        ActivityType
  media_id    String?
  media_title String?
  media_image String?
  media_type  MediaType?
  data        Json?        @default("{}")
  created_at  DateTime     @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@index([media_id])
  @@map("user_activities")
}

enum VisibilityLevel {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

model UserPrivacySettings {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String          @unique @db.Uuid
  profile_visibility   VisibilityLevel @default(PUBLIC)
  ratings_visibility   VisibilityLevel @default(PUBLIC)
  watchlist_visibility VisibilityLevel @default(PUBLIC)
  activity_visibility  VisibilityLevel @default(PUBLIC)
  updated_at           DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}

model UserFriendPreference {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  friend_id     String   @db.Uuid
  hide_activity Boolean  @default(false)
  hide_ratings  Boolean  @default(false)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user   User @relation("UserFriendPrefs", fields: [user_id], references: [id], onDelete: Cascade)
  friend User @relation("FriendOfUserPrefs", fields: [friend_id], references: [id], onDelete: Cascade)

  @@unique([user_id, friend_id])
  @@index([user_id])
  @@map("user_friend_preferences")
}
